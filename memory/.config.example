# 此模板同时提供默认值；.config 中未设置或留空的参数使用这些值。
# 同名系统环境变量优先于 .config；字节数、Token 数和优先级均为正整数。

# 每批领取上限、候选扫描上限，以及距最近日志活动的时间窗口。
MEMORY_PHASE1_MAX_SESSIONS=2
MEMORY_PHASE1_SCAN_LIMIT=5000
MEMORY_PHASE1_MAX_AGE_DAYS=10
MEMORY_PHASE1_MIN_IDLE_SECONDS=1800
MEMORY_SCAN_INTERVAL_SECONDS=120

# 单次领取的租约（应大于 API 超时）、每版本最多尝试次数、失败等待秒数。
MEMORY_PHASE1_LEASE_SECONDS=3600
MEMORY_PHASE1_MAX_ATTEMPTS=3
MEMORY_PHASE1_RETRY_DELAY_SECONDS=3600
MEMORY_PHASE1_MAX_OUTPUT_TOKENS=4096

# Phase 1：最多扫描 8 MiB，单条原始事件最多 1 MiB。
MEMORY_PHASE1_MAX_READ_BYTES=8388608
MEMORY_PHASE1_MAX_RECORD_BYTES=1048576

# 最终输入的字节上限和 Token 预算同时生效。
MEMORY_PHASE1_MAX_ROLLOUT_BYTES=8388608
# W 从根目录 .env 的 DEEPSEEK_CONTEXT_WINDOW 读取，B=floor(W × 此比例)。
# 比例必须大于 0 且不超过 1。
input_budget_ratio=0.7

# 单条格式化记录的字节上限，以及工具输出的近似 Token 上限。
MEMORY_PHASE1_MAX_ROW_BYTES=10000
MEMORY_PHASE1_TOOL_OUTPUT_TOKENS=2000

# 默认按每 4 个 UTF-8 字节估算 1 Token。
MEMORY_BYTES_PER_TOKEN=4

# 数字越小越优先，可调整顺序；相同优先级按 seq 新近程度筛选。
MEMORY_PRIORITY_USER=1
MEMORY_PRIORITY_ASSISTANT=2
MEMORY_PRIORITY_TOOL=3

# Phase 2：按使用量保留近 30 天活跃的局部记忆。
MEMORY_PHASE2_MAX_ITEMS=256
MEMORY_PHASE2_ACTIVE_DAYS=30
MEMORY_PHASE2_INTERVAL_SECONDS=21600
# 首次尝试之外的重试次数。
MEMORY_PHASE2_MAX_RETRIES=3
MEMORY_PHASE2_MAX_OUTPUT_TOKENS=8192
# 一次整合最多请求模型的次数，以及只读工具每页的字符上限。
MEMORY_PHASE2_MAX_STEPS=16
MEMORY_PHASE2_TOOL_PAGE_CHARS=8000
