# 系统环境变量覆盖 .env；未设置或留空时使用本模板的默认值。
# 模板中留空的必填参数需要自行填写；AMAP_API_KEY 可在调用高德工具前再填写。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=60

# 参考 DSH DeepSeek 适配器默认值；更换模型时需核对支持的容量
DEEPSEEK_CONTEXT_WINDOW=1000000
DEEPSEEK_MAX_OUTPUT_TOKENS=256000
# DSH 默认压缩比例，retain 必须小于 threshold
COMPACT_THRESHOLD_RATIO=0.8
COMPACT_RETAIN_RATIO=0.16

# 高德地图 Web 服务类型 Key（不是 JS API Key）
AMAP_API_KEY=
AMAP_TIMEOUT=15
